DRIVE_DOMAIN=drive.mycloudapi.fr
DRIVE_PROXY_NETWORK=mca-public
DRIVE_DATA_PATH=/opt/drive/data
POSTGRES_DB=drive
POSTGRES_USER=drive
POSTGRES_PASSWORD=change-me-with-a-long-random-password
DATABASE_URL=postgresql://drive:change-me-with-a-long-random-password@db:5432/drive
APP_DB_PASSWORD=change-me-with-another-long-random-password
APP_DATABASE_URL=postgresql://drive_app:change-me-with-another-long-random-password@db:5432/drive
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
MAX_UPLOAD_MB=12
BACKUP_RETENTION_DAYS=30
FUEL_DATA_API_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records
